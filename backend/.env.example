# Copiar a ia_api/backend/.env. Obtención de valores y claves: README.md.
# Ejemplo local: Gemini extrae CV; Groq evalúa matches. Sin credenciales reales.
PROJECT_NAME="CV Analyzer API"
MODE=development
# CORS es una lista JSON de orígenes, NO una clave. Django llama entre servidores.
BACKEND_CORS_ORIGINS=[]

# Claves externas: Google AI Studio y Groq Console, respectivamente.
LLM_PROVIDER=gemini
MATCH_PROVIDER=groq
GEMINI_API_KEY=
GROQ_API_KEY=
# IDs de la configuración actual; verificar disponibilidad en cada cuenta.
GEMINI_MODEL=gemini-3.5-flash-lite
MATCH_GROQ_MODEL=qwen/qwen3.8-27b
MATCH_GROQ_MAX_TOKENS=6000
# CV_MODEL solo para LLM_PROVIDER=groq y fallback del modelo de match.
CV_MODEL=qwen/qwen3.8-27b

# Presupuestos locales actuales: NO otorgan cuota. Revisar AI Studio antes de usar.
GEMINI_REQUESTS_PER_MINUTE=12
GEMINI_INPUT_TOKENS_PER_MINUTE=200000
GEMINI_REQUESTS_PER_DAY=400
GEMINI_MAX_INPUT_TOKENS_PER_REQUEST=60000
GEMINI_MAX_OUTPUT_TOKENS=16384
GEMINI_PAUSA_SEGUNDOS=0
CV_PACKET_CHARACTERS=20000
CV_BLOQUE_CARACTERES=20000
CV_EXTRACTION_MAX_TOKENS=16384
# Presupuestos Groq: verificar cuenta/modelo en la consola.
GROQ_MAX_TOKENS=6000
GROQ_PAUSA_SEGUNDOS=12
GROQ_REQUESTS_PER_MINUTE=20

# Generar y copiar también en IA_API_TOKEN y MATCH_API_TOKEN de Django.
SERVICE_API_TOKEN=
# Secreto diferente al anterior; copiar en IA_CALLBACK_HMAC_SECRET de Django.
CV_RESULT_CALLBACK_HMAC_SECRET=
# Local: 8000. VPS con Caddy y HTTPS: cambiar por 8080.
CV_RESULT_CALLBACK_URL=http://127.0.0.1:8000/ia/llegue/

# Redis local: CHANNEL_REDIS_URL idéntico al de Django.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
JOB_STORE_REDIS_URL=redis://127.0.0.1:6379/2
CHANNEL_REDIS_URL=redis://127.0.0.1:6379/3
MATCH_REDIS_URL=redis://127.0.0.1:6379/4
JOB_TTL_SECONDS=2592000

# Límites del flujo documental; no son credenciales.
CV_MAX_PDF_BYTES=5242880
CV_MAX_PDF_PAGES=20
CV_MAX_TEXT_CHARACTERS=100000
CV_EXTRACT_TIMEOUT_SECONDS=40
CV_MAX_ARCHIVE_BYTES=52428800
CV_MAX_ARCHIVE_ENTRIES=200
CV_MAX_UPLOAD_BODY_OVERHEAD=262144
CV_ARTIFACT_DIR=private_cv_artifacts
# Opcional DOC/RTF: vacío hasta construir/probar el conversor aislado.
CV_LEGACY_CONVERTER_IMAGE=
CV_DOCKER_COMMAND=docker
CV_LEGACY_CONVERSION_TIMEOUT_SECONDS=30

# RAG opcional: URL vacía usa el catálogo JSON, sin PostgreSQL vectorial.
CV_RAG_CONTEXT_MAX_CHARACTERS=16000
SKILL_CATALOG_DATABASE_URL=
# Solo docker-compose.rag.yml usa esta contraseña para crear la base del catálogo.
SKILL_CATALOG_DB_PASSWORD=
SKILL_CATALOG_EMBEDDING_DIMENSIONS=384
SKILL_CATALOG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
