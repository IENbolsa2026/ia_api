# Copiar este archivo como .env y completar los valores reales.
# Nunca subir .env al repositorio: contiene secretos.

PROJECT_NAME="CV Analyzer API"
MODE=development
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Clave de la cuenta que llama al modelo de IA.
GROQ_API_KEY="gsk_reemplazar_por_tu_clave"
CV_MODEL="qwen/qwen3.8-27b"
CV_BLOQUE_CARACTERES=4000
GROQ_MAX_TOKENS=950
GROQ_PAUSA_SEGUNDOS=12

# Redis local, iniciado con: docker compose up -d redis
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# Ruta HTTP de la aplicacion que recibira el analisis final.
CV_RESULT_CALLBACK_URL="http://127.0.0.1:8000/ia/llegue/"
# Debe coincidir con IA_CALLBACK_TOKEN de Django. Puede quedar
# vacio en desarrollo si el receptor no requiere autenticacion.
CV_RESULT_CALLBACK_SECRET="cambiar-por-un-secreto-compartido"

# Variables heredadas del esqueleto original. Se mantienen para que Settings
# pueda iniciar mientras no se quite aun ese codigo del proyecto.
JWT_SECRET_KEY="solo-para-desarrollo"
SERVICE_USER="service"
SERVICE_PASSWORD="cambiar-por-password"
