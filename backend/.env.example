# Copiar este archivo como .env y completar los valores reales.
# Nunca subir .env al repositorio: contiene secretos.

PROJECT_NAME="CV Analyzer API"
MODE=development
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Proveedor de extracción actual.
LLM_PROVIDER="groq"

# Alternativa ligera: LLM_PROVIDER=gemini. Clave privada de Google AI Studio.
# Para reducir llamadas: CV_PACKET_CHARACTERS=20000, CV_BLOQUE_CARACTERES=20000
# y CV_EXTRACTION_MAX_TOKENS=16384. El presupuesto de entrada divide si hace falta.
# Estos límites son locales; revisar las cuotas reales del proyecto en AI Studio.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_REQUESTS_PER_MINUTE=4
GEMINI_PAUSA_SEGUNDOS=0
GEMINI_MAX_OUTPUT_TOKENS=16384
GEMINI_INPUT_TOKENS_PER_MINUTE=20000
GEMINI_REQUESTS_PER_DAY=20
GEMINI_MAX_INPUT_TOKENS_PER_REQUEST=12000

# Crear esta clave en https://console.groq.com/keys.
GROQ_API_KEY="gsk_reemplazar_por_tu_clave"
CV_MODEL="qwen/qwen3.8-27b"
CV_BLOQUE_CARACTERES=4000
CV_PACKET_CHARACTERS=500
CV_EXTRACTION_MAX_TOKENS=950
GROQ_MAX_TOKENS=6000
GROQ_PAUSA_SEGUNDOS=12
GROQ_REQUESTS_PER_MINUTE=20
CV_MAX_PDF_BYTES=5242880
CV_MAX_PDF_PAGES=20
CV_MAX_TEXT_CHARACTERS=100000
CV_EXTRACT_TIMEOUT_SECONDS=40
CV_MAX_ARCHIVE_BYTES=52428800
CV_MAX_ARCHIVE_ENTRIES=200
CV_ARTIFACT_DIR="private_cv_artifacts"
# Si se habilita, requiere un escáner configurado. En Windows, la ruta debe apuntar
# a MpCmdRun.exe de Microsoft Defender; cualquier error bloquea el procesamiento.
CV_SCAN_ENABLED=false
CV_SCAN_COMMAND=""
CV_SCAN_TIMEOUT_SECONDS=30
CV_DOCKER_COMMAND="docker"
# Imagen propia, con LibreOffice instalado y salida a texto. Al habilitarla,
# la conversión corre sin red, con 512 MiB, 1 CPU y máximo 30 segundos.
CV_LEGACY_CONVERTER_IMAGE=""
CV_LEGACY_CONVERSION_TIMEOUT_SECONDS=30

# Token Bearer que usa Bolsa para crear o consultar extracciones.
SERVICE_API_TOKEN="reemplazar-por-token-de-servicio"

# Redis local, iniciado con: docker compose up -d redis
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"
# Registro idempotente de trabajos y rate limiter de Groq.
JOB_STORE_REDIS_URL="redis://localhost:6379/2"
CHANNEL_REDIS_URL="redis://localhost:6379/3"
JOB_TTL_SECONDS=2592000

# Ruta HTTP de la aplicacion que recibira el analisis final.
CV_RESULT_CALLBACK_URL="http://127.0.0.1:8000/ia/llegue/"
# Debe coincidir con IA_CALLBACK_TOKEN de Django. Puede quedar
# vacio en desarrollo si el receptor no requiere autenticacion.
CV_RESULT_CALLBACK_SECRET="cambiar-por-un-secreto-compartido"
CV_RESULT_CALLBACK_HMAC_SECRET="cambiar-por-un-secreto-hmac"

# Variables heredadas del esqueleto original. Se mantienen para que Settings
# pueda iniciar mientras no se quite aun ese codigo del proyecto.
JWT_SECRET_KEY="solo-para-desarrollo"
SERVICE_USER="service"
SERVICE_PASSWORD="cambiar-por-password"
MATCH_GROQ_MODEL=llama-3.3-70b-versatile
MATCH_GROQ_MAX_TOKENS=6000
MATCH_REDIS_URL=redis://localhost:6379/4
